<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j2 Configuration — AI Code Assistant Backend
  日志策略与 Debug 系统:
    - 5 级日志: TRACE(VERBOSE), DEBUG, INFO, WARN, ERROR
    - 控制台 + 文件输出 + 滚动策略
    - 安全审计日志与业务日志物理分离
    - 内存错误队列: 由 InMemoryErrorLog bean 实现 (非 Log4j2 管理)
-->
<Configuration status="WARN" monitorInterval="30">

    <Properties>
        <!-- 日志目录: 优先使用环境变量 LOG_DIR，回退到项目根/log/ -->
        <Property name="APP_LOG_DIR">${env:LOG_DIR:-${sys:user.dir}/../log}</Property>
        <Property name="CORRELATION_PATTERN">[sid=%replace{%X{sessionId}}{^$}{-} rid=%replace{%X{runId}}{^$}{-} prid=%replace{%X{parentRunId}}{^$}{-} agent=%replace{%X{agentType}}{^$}{-} turn=%replace{%X{turn}}{^$}{-} tool=%replace{%X{toolUseId}}{^$}{-} llm=%replace{%X{llmRequestId}}{^$}{-}]</Property>
        <!-- 控制台日志格式: 时间 级别 [线程] 关联信息 类名 - 消息 -->
        <Property name="CONSOLE_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight{%-5level} [%thread] ${CORRELATION_PATTERN} %cyan{%logger{36}} - %msg%n</Property>
        <!-- 文件日志格式: 时间 级别 [线程] 关联信息 类全名 - 消息 -->
        <Property name="FILE_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] ${CORRELATION_PATTERN} %logger{60} - %msg%n</Property>
    </Properties>

    <Appenders>
        <!-- ===== 控制台输出 ===== -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${CONSOLE_PATTERN}" charset="UTF-8"/>
        </Console>

        <!-- ===== 主日志文件 (滚动策略: 每天 + 10MB 切割, 保留 30 天) ===== -->
        <RollingFile name="AppFile"
                     fileName="${APP_LOG_DIR}/app.log"
                     filePattern="${APP_LOG_DIR}/app-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${FILE_PATTERN}" charset="UTF-8"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30">
                <Delete basePath="${APP_LOG_DIR}" maxDepth="1">
                    <IfFileName glob="app-*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- ===== 错误日志 (仅 WARN+ERROR, 独立文件便于快速排查) ===== -->
        <RollingFile name="ErrorFile"
                     fileName="${APP_LOG_DIR}/error.log"
                     filePattern="${APP_LOG_DIR}/error-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${FILE_PATTERN}" charset="UTF-8"/>
            <Filters>
                <ThresholdFilter level="WARN" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30">
                <Delete basePath="${APP_LOG_DIR}" maxDepth="1">
                    <IfFileName glob="error-*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- ===== Debug 日志 (TRACE+DEBUG 级别, getDebugWriter 缓冲写入) ===== -->
        <RollingFile name="DebugFile"
                     fileName="${APP_LOG_DIR}/debug/debug.log"
                     filePattern="${APP_LOG_DIR}/debug/debug-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${FILE_PATTERN}" charset="UTF-8"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="7">
                <Delete basePath="${APP_LOG_DIR}/debug" maxDepth="1">
                    <IfFileName glob="debug-*.log.gz"/>
                    <IfLastModified age="7d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <RollingFile name="SecurityAuditFile"
                     fileName="${APP_LOG_DIR}/security-audit.log"
                     filePattern="${APP_LOG_DIR}/security-audit-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${FILE_PATTERN}" charset="UTF-8"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <RollingFile name="ObservabilityEventsFile" ignoreExceptions="false"
                     fileName="${APP_LOG_DIR}/observability-events.log"
                     filePattern="${APP_LOG_DIR}/observability-events-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %enc{%msg}{CRLF}%n" charset="UTF-8"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="14">
                <Delete basePath="${APP_LOG_DIR}" maxDepth="1">
                    <IfFileName glob="observability-events-*.log.gz"/>
                    <IfLastModified age="14d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- ===== MCP 心跳日志降噪 ===== -->
        <Logger name="com.aicodeassistant.mcp.McpServerConnection" level="INFO" additivity="false">
            <AppenderRef ref="AppFile"/>
        </Logger>

        <Logger name="security-audit" level="INFO" additivity="false">
            <AppenderRef ref="SecurityAuditFile"/>
        </Logger>

        <Logger name="observability-events" level="INFO" additivity="false">
            <AppenderRef ref="ObservabilityEventsFile"/>
        </Logger>

        <!-- ===== 应用日志 ===== -->
        <Logger name="com.aicodeassistant" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AppFile"/>
            <AppenderRef ref="ErrorFile"/>
            <AppenderRef ref="DebugFile"/>
        </Logger>

        <!-- ===== Spring Framework 日志 ===== -->
        <Logger name="org.springframework" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AppFile"/>
            <AppenderRef ref="ErrorFile"/>
        </Logger>
        <Logger name="org.springframework.web.socket" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AppFile"/>
        </Logger>
        <Logger name="org.springframework.messaging" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AppFile"/>
        </Logger>

        <!-- ===== 第三方库降噪 ===== -->
        <Logger name="org.apache.catalina" level="WARN"/>
        <Logger name="org.hibernate" level="WARN"/>
        <Logger name="com.zaxxer.hikari" level="INFO"/>
        <Logger name="org.xerial.snappy" level="WARN"/>
        <!-- Alibaba SDK logs must not expose STS credentials or signed requests. -->
        <Logger name="com.aliyun.sdk.service.oss2" level="WARN"/>
        <Logger name="com.aliyun.credentials" level="WARN"/>

        <!-- ===== Root ===== -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AppFile"/>
            <AppenderRef ref="ErrorFile"/>
        </Root>
    </Loggers>

</Configuration>
