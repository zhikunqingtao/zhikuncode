# R-12 office-regression pinned toolchain (single source of truth).
#
# The Dockerfile installs exactly these versions and
# tests/test_preflight.py asserts the container really carries them.
# Values were resolved from the live noble-updates repository on 2026-09-29
# inside mcr.microsoft.com/playwright/python:v1.58.0-noble (Ubuntu 24.04.3).
#
# Usage: `set -a; . pins.env; set +a` (sh/bash compatible; quote spaces in values).

BASE_IMAGE=mcr.microsoft.com/playwright/python:v1.58.0-noble
BASE_IMAGE_DIGEST=sha256:678457c4c323b981d8b4befc57b95366bb1bb6aa30057b1269f6b171e8d9975a

# LibreOffice (all binary packages share 4:24.2.7-0ubuntu0.24.04.6 in noble-updates)
LIBREOFFICE_VERSION=4:24.2.7-0ubuntu0.24.04.6
SOFFICE_VERSION_PREFIX="LibreOffice 24.2.7"

# CJK fonts + PDF text/rendering tooling
FONTS_NOTO_CJK_VERSION=1:20230817+repack1-3
POPPLER_UTILS_VERSION=24.02.0-1ubuntu9.9

# Python test/runtime packages (installed into /opt/r12/venv)
PLAYWRIGHT_VERSION=1.58.0
PYTEST_VERSION=8.3.4
PYTEST_TIMEOUT_VERSION=2.3.1
FASTAPI_VERSION=0.115.6
STARLETTE_VERSION=0.41.3
UVICORN_VERSION=0.32.1
PYDANTIC_VERSION=2.10.3
